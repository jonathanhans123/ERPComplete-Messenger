# Normalize line endings so files stay LF in the repo.
* text=auto
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.sh text eol=lf
# Binary / generated: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.apk binary
*.aab binary
*.jar binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.m4a binary
